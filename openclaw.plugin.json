{
  "name": "ISPConfig",
  "id": "openclaw-ispconfig",
  "version": "0.4.1",
  "description": "Manage ISPConfig servers: automated site provisioning, domains, mailboxes, DNS, databases, SSL, backups, and more.",
  "tools": [
    "isp_methods_list",
    "isp_system_info",
    "isp_provision_site",
    "isp_client_list",
    "isp_client_add",
    "isp_client_get",
    "isp_sites_list",
    "isp_site_get",
    "isp_site_add",
    "isp_domains_list",
    "isp_domain_add",
    "isp_dns_zone_list",
    "isp_dns_zone_add",
    "isp_dns_record_list",
    "isp_dns_record_add",
    "isp_dns_record_delete",
    "isp_mail_domain_list",
    "isp_mail_domain_add",
    "isp_mail_user_list",
    "isp_mail_user_add",
    "isp_mail_user_delete",
    "isp_db_list",
    "isp_db_add",
    "isp_db_user_add",
    "isp_ssl_status",
    "isp_quota_check",
    "isp_backup_list",
    "isp_shell_user_add",
    "isp_ftp_user_add",
    "isp_cron_list",
    "isp_cron_add",
    "isp_client_update",
    "isp_client_delete",
    "isp_site_update",
    "isp_site_delete",
    "isp_mail_domain_delete",
    "isp_mail_alias_list",
    "isp_mail_alias_add",
    "isp_mail_alias_delete",
    "isp_mail_forward_list",
    "isp_mail_forward_add",
    "isp_mail_forward_delete",
    "isp_dns_zone_delete",
    "isp_dns_record_update",
    "isp_db_delete",
    "isp_db_user_delete",
    "isp_ftp_user_delete",
    "isp_shell_user_delete",
    "isp_cron_delete",
    "isp_cron_update",
    "isp_dns_zone_get",
    "isp_dns_zone_update",
    "isp_mail_domain_update",
    "isp_mail_user_update",
    "isp_mail_alias_update",
    "isp_mail_forward_update",
    "isp_db_get",
    "isp_db_update",
    "isp_db_user_get",
    "isp_db_user_update",
    "isp_ftp_user_get",
    "isp_ftp_user_update",
    "isp_shell_user_get",
    "isp_shell_user_update"
  ],
  "configSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "apiUrl",
      "username",
      "password"
    ],
    "properties": {
      "apiUrl": {
        "type": "string",
        "description": "ISPConfig Remote JSON API URL (e.g. https://server:8080/remote/json.php)"
      },
      "username": {
        "type": "string",
        "description": "ISPConfig remote API username"
      },
      "password": {
        "type": "string",
        "description": "ISPConfig remote API password",
        "secret": true
      },
      "serverId": {
        "type": "number",
        "description": "Default ISPConfig server ID (usually 1 for single-server setups)",
        "default": 1
      },
      "defaultServerIp": {
        "type": "string",
        "description": "Default server IP for DNS A records"
      },
      "readOnly": {
        "type": "boolean",
        "description": "If true, only read operations are allowed",
        "default": false
      },
      "allowedOperations": {
        "type": "array",
        "description": "Whitelist of allowed tool names. Empty = all allowed.",
        "default": [],
        "items": {
          "type": "string"
        }
      },
      "verifySsl": {
        "type": "boolean",
        "description": "Verify SSL certificate of ISPConfig server",
        "default": true
      }
    }
  }
}
