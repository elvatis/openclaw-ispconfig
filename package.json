{
  "name": "@elvatis/openclaw-ispconfig",
  "version": "2026.8.1",
  "description": "OpenClaw plugin for ISPConfig server management - domains, mailboxes, databases, DNS, websites",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md"
  ],
  "keywords": [
    "openclaw",
    "ispconfig",
    "hosting",
    "dns",
    "mailbox",
    "server-management"
  ],
  "author": "Elvatis",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elvatis/openclaw-ispconfig.git"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.0"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.8.1"
    },
    "install": {
      "clawhubSpec": "clawhub:@elvatis/openclaw-ispconfig",
      "defaultChoice": "clawhub",
      "minHostVersion": ">=2026.8.1"
    },
    "build": {
      "openclawVersion": "2026.8.1",
      "bundledDist": true
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": false
    }
  },
  "overrides": {
    "test-exclude": "^7.0.1"
  }
}
